{
  "name": "debater",
  "version": "0.1.0",
  "private": true,
  "description": "Two realtime voice agents — an egg and a potato — debating each other at two podiums, with you as the moderator, on OpenAI or xAI",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "preview": "npm run build && npm start",
    "preview:lan": "npm run build && npm start -- --https",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2"
  }
}
