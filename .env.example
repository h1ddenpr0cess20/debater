# Copy to .env — both `npm run dev` and `npm start` read it.
#
# Two lecterns, two engines to run them on. Set one key, or set both and pick
# from the bar at the bottom of the page. Either key stays in the Node process.

# ── the OpenAI engine ───────────────────────────────────────────────────────
# The browser only ever sees two ten-minute client secrets minted from this,
# one per lectern, and the calls themselves run browser-to-OpenAI over WebRTC.
OPENAI_API_KEY=sk-...

# One voice each, or they sound like one debater arguing with himself. Known:
# ash, alloy, ballad, cedar, coral, echo, marin, sage, shimmer, verse.
# EGG_VOICE=ash
# POTATO_VOICE=cedar

# Preselected in the model picker when the key can reach it.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Point the proxy at a gateway or a stub instead of OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── the xAI engine ──────────────────────────────────────────────────────────
# This one is proxied: both calls go browser → this server → api.x.ai over a
# WebSocket, because an xAI realtime session wants the key on it and a key is
# not something to hand a browser. Nothing of it reaches the page.
# XAI_API_KEY=xai-...

# One voice each again. All 26 are in the picker: the heavy end is rex, sal,
# atlas, zagan, orion, perseus, leo, helix, zenith, rigel, castor, ursa, naksh,
# kepler; the lighter one is ara, eve, carina, luna, iris, celeste, lumen, lux,
# cosmo, sirius, altair, helios. The defaults are two of the heavy ones, since
# both characters are written as men — change them freely.
# EGG_XAI_VOICE=orion
# POTATO_XAI_VOICE=atlas

# grok-voice-latest tracks the newest release; pin a snapshot if you'd rather.
# XAI_MODEL=grok-voice-latest

# Point it at a gateway or a stub instead of xAI.
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime

# The hosted tools, in the `tools` panel when this engine is running. Both are
# executed by xAI, not by us — no keys needed, and nothing runs on this machine.
# A debate where either side can be asked for a source is a better debate.
# XAI_WEB_SEARCH=true
# XAI_X_SEARCH=true

# Remote MCP servers, as a JSON array. Anything with credentials belongs here
# rather than in the page — the proxy is the only thing that reads it, and the
# page is told the label and nothing else. Or drop the same array in ./mcp.json.
# XAI_MCP_SERVERS=[{"server_label":"my-tools","server_url":"https://mcp.example.com/mcp","authorization":"Bearer ..."}]
# XAI_MCP_FILE=mcp.json

# Which engine the page opens on: openai or xai. Left unset, whichever there is
# a key for, preferring OpenAI.
# ENGINE=openai

# The caps the page opens on. Two live realtime calls bill for as long as they
# are open, and a debate nobody is watching will happily run until the key does
# not work any more — so these exist, and the page cannot switch them off.
# DEBATE_TURNS=12           # turns before it hangs up
# DEBATE_SECONDS=480        # wall clock before it hangs up
# DEBATE_IDLE_SECONDS=90    # how long a pause may sit there before it hangs up

# Connectors. None are registered yet — see src/server/connectors/catalog.js —
# so this does nothing until one is. When there is one, naming it here switches
# it on at boot; the panel writes the same thing to connectors.json.
# CONNECTORS=
# CONNECTOR_FILE=connectors.json

# PORT=5173
