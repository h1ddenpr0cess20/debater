# Copy to .env — both `npm run dev` and `npm start` read it.
# The key stays in the Node process; the browser only ever sees two ten-minute
# client secrets minted from it, one per lectern.
OPENAI_API_KEY=sk-...

# One voice each, or they sound like one debater arguing with himself. Known:
# ash, alloy, ballad, cedar, coral, echo, marin, sage, shimmer, verse.
# EGG_VOICE=ash
# POTATO_VOICE=cedar

# Preselected in the model picker when the key can reach it.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Point the proxy at a gateway or a stub instead of OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# The caps the page opens on. Two live realtime calls bill for as long as they
# are open, and a debate nobody is watching will happily run until the key does
# not work any more — so these exist, and the page cannot switch them off.
# DEBATE_TURNS=12           # turns before it hangs up
# DEBATE_SECONDS=480        # wall clock before it hangs up
# DEBATE_IDLE_SECONDS=90    # how long a pause may sit there before it hangs up

# Connectors. None are registered yet — see src/server/connectors/catalog.js —
# so this does nothing until one is. When there is one, naming it here switches
# it on at boot; the panel writes the same thing to connectors.json.
# CONNECTORS=
# CONNECTOR_FILE=connectors.json

# PORT=5173
